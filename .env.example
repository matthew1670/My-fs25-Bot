# Discord bot token from Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=your_bot_token_here

# Optional, but recommended for quick slash command syncing to one server.
# Enable Developer Mode in Discord, right-click your server, Copy Server ID.
DISCORD_GUILD_ID=your_discord_server_id_here

# Webhook URL for automatic alert messages
DISCORD_WEBHOOK=your_discord_webhook_url_here

# Your FS25 dedicated server XML feed
FS25_XML_URL=http://example.com/feed/dedicated-server-stats.xml?code=your_code_here

# How often the bot checks the XML feed
CHECK_EVERY_SECONDS=10
REQUEST_TIMEOUT=5
